# -----------------------------------------------------------------------------
# LearnWithMe · environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# -----------------------------------------------------------------------------

# --- Supabase (https://supabase.com/dashboard) --------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI provider --------------------------------------------------------------
# AI_PROVIDER: "groq" (hosted free, open-weight)  |  "ollama" (local dev)  |  "claude" (paid, best quality)
AI_PROVIDER="groq"

# Groq — https://console.groq.com/keys · free, no card
GROQ_API_KEY=""
GROQ_MODEL_LARGE="openai/gpt-oss-120b"
GROQ_MODEL_SMALL="openai/gpt-oss-20b"

# Ollama — local dev fallback. Run `ollama serve` in another terminal.
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL_LARGE="llama3.2:latest"
OLLAMA_MODEL_SMALL="llama3.2:latest"

# Claude — https://console.anthropic.com/settings/keys · SEPARATE from your claude.ai subscription
ANTHROPIC_API_KEY=""
CLAUDE_MODEL_LARGE="claude-opus-5"
CLAUDE_MODEL_SMALL="claude-opus-5"

# --- Observability (optional, free tiers) -------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
SENTRY_DSN=""

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
