# -----------------------------------------------------------------------------
# LearnWithMe · environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# -----------------------------------------------------------------------------

# --- Supabase (https://supabase.com/dashboard) --------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI provider (open-weight only) -------------------------------------------
# AI_PROVIDER: "groq" (hosted, free tier)  |  "ollama" (local dev)
AI_PROVIDER="groq"

# Groq — https://console.groq.com/keys · free, no card
GROQ_API_KEY=""
GROQ_MODEL_LARGE="llama-3.3-70b-versatile"
GROQ_MODEL_SMALL="llama-3.1-8b-instant"

# Ollama — local dev fallback. Run `ollama serve` in another terminal.
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL_LARGE="llama3.2:latest"
OLLAMA_MODEL_SMALL="llama3.2:latest"

# --- Observability (optional, free tiers) -------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
SENTRY_DSN=""

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
